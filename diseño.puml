@startuml
skinparam classAttributeIconSize 0

interface Mapa<K, V> {
  + put(clave: K, valor: V): void
  + get(clave: K): V
  + size(): int
}

note right of Mapa
  **Contrato Mapa<K, V>:**
  - Pre: clave != null y valor != null (sino IllegalArgumentException).
  - Post: igualdad por contenido (.equals); si clave existe,
    sobrescribe valor sin incrementar size().
  - Post: get(clave) retorna null si la clave no existe.
end note

class MapaBST<K extends Comparable<K>, V> {
  - st: BST<K, V>
  + put(clave: K, valor: V): void
  + get(clave: K): V
  + size(): int
}

class MapaRBBST<K extends Comparable<K>, V> {
  - st: RedBlackBST<K, V>
  + put(clave: K, valor: V): void
  + get(clave: K): V
  + size(): int
}

class MapaSCH<K, V> {
  - st: SeparateChainingHashST<K, V>
  + put(clave: K, valor: V): void
  + get(clave: K): V
  + size(): int
}

class MapaLPH<K, V> {
  - st: LinearProbingHashST<K, V>
  + put(clave: K, valor: V): void
  + get(clave: K): V
  + size(): int
}

class Mensaje {
  - id: int
  - origen: String
  - destino: String
  + Mensaje(id: int, origen: String, destino: String)
  + id(): int
  + origen(): String
  + destino(): String
}

note right of Mensaje
  **Contrato Mensaje (Inmutable):**
  - Pre: origen != null y destino != null (sino IllegalArgumentException).
  - Inv: atributos finales sin mutadores; identidad logica por id.
end note

class GeneradorTopologia {
  - filas: int
  - columnas: int
  + GeneradorTopologia(filas: int, columnas: int)
  + cantidadVertices(): int
  + generar(semilla: long): Graph
  + identificador(v: int): String
}

class Generador {
  - topologia: GeneradorTopologia
  - grafo: Graph
  - n: int
  - bfs: BreadthFirstPaths[]
  - demanda: List<Mensaje>[]
  + Generador(topologia: GeneradorTopologia, semillaTopologia: long, semillaDemanda: long)
  + topologia(): GeneradorTopologia
  + grafo(): Graph
  + n(): int
  + bfs(v: int): BreadthFirstPaths
  + demanda(v: int): List<Mensaje>
}

note right of Generador
  **Contrato Generador:**
  - Pre: topologia != null; deben existir destinos a distancia 4
    para cada vertice (sino lanza IllegalStateException).
  - Post: determinista segun semillas; genera exactamente 4 mensajes
    por vertice hacia destinos con distTo(d) == 4.
end note

class Simulador {
  - generador: Generador
  - tablas: Mapa<String, Integer>[]
  + Simulador(generador: Generador, tablas: Mapa<String, Integer>[])
  + Simulador(generador: Generador, tablas: Mapa<String, Integer>[], ordenClaves: List<String>)
  - {static} ordenPorDefecto(generador: Generador): List<String>
  - prepararTablas(ordenClaves: List<String>): void
  + nuevaEjecucion(): Ejecucion
}

note right of Simulador
  **Contrato Simulador:**
  - Pre: tablas.length == n y ordenClaves.size() == n.
  - Post: cada tabla[i] almacena n-1 destinos con el vecino w
    que reduce distTo en 1 (desempate por menor indice).
end note

class "Simulador.Ejecucion" as Ejecucion {
  - filas: LinkedQueue<Mensaje>[]
  - activos: LinkedQueue<Integer>
  - enAgenda: boolean[]
  + Ejecucion()
  - agendar(v: int): void
  + filasVacias(): boolean
  + simular(): Resultado
}

note right of Ejecucion
  **Contrato Ejecucion (Estado aislado):**
  - Inv: enAgenda[v] evita duplicados en cola activos;
    maximo 1 transmision por vertice activo en cada periodo.
  - Post: al terminar, activos.isEmpty() y filasVacias() == true.
end note

class "Simulador.Resultado" as Resultado {
  + entregados: int
  + transmisiones: int
  + periodos: int
  + Resultado(entregados: int, transmisiones: int, periodos: int)
}

class Experimento {
  + {static} main(args: String[]): void
}

Mapa <|.. MapaBST
Mapa <|.. MapaRBBST
Mapa <|.. MapaSCH
Mapa <|.. MapaLPH

Generador --> GeneradorTopologia : usa
Generador o-- Mensaje : genera demanda
Simulador --> Generador : consulta
Simulador o-- Mapa : tablas[n]
Simulador +-- Ejecucion : clase interna
Simulador +-- Resultado : clase interna estatica
Ejecucion ..> Mensaje : encola y rutea
Ejecucion ..> Resultado : retorna
Experimento ..> GeneradorTopologia : instancia
Experimento ..> Generador : instancia
Experimento ..> Simulador : ejecuta lotes
Experimento ..> Mapa : evalua
@enduml
